<dialog class="yh-sheet" id="picker" aria-labelledby="picker-title">
  <div class="yh-sheet-box">
    <header class="yh-sheet-head">
      <h2 id="picker-title">选参与人</h2>
      <button class="yh-btn yh-btn--text" type="button" data-close aria-label="关闭">×</button>
    </header>
    <div class="yh-sheet-body">
      <input class="yh-input" id="picker-q" type="search" placeholder="搜姓名或部门" aria-label="搜姓名或部门">
      <p class="note-line" id="picker-msg" hidden></p>
      <ul class="people" id="picker-list"></ul>
    </div>
    <footer class="yh-sheet-foot">
      <button class="yh-btn" id="picker-done" type="button">完成</button>
    </footer>
  </div>
</dialog>
