<% const any = groups.some((g) => g.list.length) %>
<% if (!any) { %>
  <div class="yh-empty">
    <p><%= q || project ? '没有找到相关会议。' : '还没有会议。' %></p>
    <% if (!q && !project) { %><a class="yh-btn" href="import">导入会议记录</a><% } %>
  </div>
<% } else { %>
  <% for (const g of groups) { %>
    <% if (g.list.length) { %>
      <% if (g.title) { %><h2 class="group"><%= g.title %></h2><% } %>
      <ul class="bare" data-group="<%= g.key %>">
        <% for (const m of g.list) { %>
          <li class="meeting" data-id="<%= m.id %>">
            <a class="yh-row" href="meetings/<%= m.id %>">
              <span class="yh-row-main">
                <span class="yh-row-title" title="<%= m.title %>"><%= m.title %></span>
                <span class="yh-row-status status <%= m.status %>"><%= m.status_label %></span>
              </span>
              <span class="yh-row-sub">
                <span class="when"><%= m.when %></span>
                <% if (m.project) { %><span class="project"><%= m.project %></span><% } %>
                <span><%= m.people %> 人</span>
                <% if (m.has_note) { %><span class="yh-tag">纪要</span><% } %>
              </span>
            </a>
          </li>
        <% } %>
      </ul>
    <% } %>
  <% } %>
  <% if (capped) { %><p class="note-line center">只显示最近的 200 场，更早的用搜索找。</p><% } %>
<% } %>
