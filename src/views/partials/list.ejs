<% const any = groups.some((g) => g.list.length) %>
<% if (!any) { %>
  <p class="empty"><%= q ? '没有找到相关会议。' : '还没有会议。' %></p>
<% } else { %>
  <% for (const g of groups) { %>
    <% if (g.list.length) { %>
      <% if (g.title) { %><h2 class="group"><%= g.title %></h2><% } %>
      <ul class="list" data-group="<%= g.key %>">
        <% for (const m of g.list) { %>
          <li class="meeting" data-id="<%= m.id %>">
            <a class="row" href="meetings/<%= m.id %>">
              <span class="title" title="<%= m.title %>"><%= m.title %></span>
              <span class="meta">
                <span class="when"><%= m.when %></span>
                <span><%= m.people %> 人</span>
                <span class="status <%= m.status %>"><%= m.status_label %></span>
                <% if (m.has_note) { %><span class="tag">纪要</span><% } %>
              </span>
            </a>
          </li>
        <% } %>
      </ul>
    <% } %>
  <% } %>
  <% if (capped) { %><p class="note-line center">只显示最近的 200 场，更早的用搜索找。</p><% } %>
<% } %>
