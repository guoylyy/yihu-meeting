<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<base href="<%= base %>">
<title><%= meeting ? meeting.title : '会议与纪要' %></title>
<link rel="stylesheet" href="static/yh-vi.css?v=<%= version %>">
<link rel="stylesheet" href="static/app.css?v=<%= version %>">
<script src="static/app.js?v=<%= version %>" defer></script>
<% if (meeting) { %><script src="static/detail.js?v=<%= version %>" defer></script><% } %>
<% if (script) { %><script src="static/<%= script %>.js?v=<%= version %>" defer></script><% } %>
</head>
<body data-tz="<%= tz %>"<% if (meeting) { %> data-id="<%= meeting.id %>"<% } %>>
<header class="yh-top">
  <a class="yh-top-brand" href="./"><span aria-hidden="true">🗓️</span>会议与纪要</a>
  <div class="yh-top-right">
    <% if (version) { %><span class="yh-ver" id="version">v<%= version %></span><% } %>
    <details class="yh-menu" id="user-menu">
      <summary aria-label="账号菜单"><span class="yh-avatar"><%= initial %></span></summary>
      <nav class="yh-menu-list" aria-label="账号菜单">
        <% if (version) { %><span class="yh-menu-ver">版本 v<%= version %></span><% } %>
        <a href="settings">设置</a>
        <a href="about">关于</a>
        <% if (hosted) { %><a href="logout" id="logout-link">退出</a><% } %>
      </nav>
    </details>
  </div>
</header>
