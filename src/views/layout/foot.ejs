<dialog class="yh-sheet yh-sheet--auto" id="confirm" aria-labelledby="confirm-title">
  <div class="yh-sheet-box">
    <div class="yh-sheet-body">
      <h2 class="confirm-title" id="confirm-title"></h2>
      <p class="note-line" id="confirm-text"></p>
    </div>
    <footer class="yh-sheet-foot">
      <button class="yh-btn yh-btn--ghost" id="confirm-no" type="button">取消</button>
      <button class="yh-btn" id="confirm-yes" type="button">确定</button>
    </footer>
  </div>
</dialog>

<div class="yh-toast" id="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>
