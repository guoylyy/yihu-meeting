<dialog class="sheet confirm" id="confirm" aria-labelledby="confirm-title">
  <div class="sheet-box">
    <div class="sheet-body">
      <h2 id="confirm-title"></h2>
      <p class="note-line" id="confirm-text"></p>
    </div>
    <footer class="sheet-foot two">
      <button class="btn" id="confirm-no" type="button">取消</button>
      <button class="btn primary" id="confirm-yes" type="button">确定</button>
    </footer>
  </div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>
