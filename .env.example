# 本地开发用；平台上这些都由平台注入，不用配
PORT=3000
DATABASE_URL=mysql://root:password@127.0.0.1:3306/meeting

# 统一登录与平台模型。不配时本地以「本地用户」匿名运行（只在 NODE_ENV 不是 production 时）
YH_CLIENT_ID=
YH_CLIENT_SECRET=
YH_WEB_URL=http://localhost:5185
YH_API_URL=http://localhost:3105
YH_APP_URL=http://localhost:3000

# 会议时间按哪个时区录入和显示，默认 Asia/Shanghai
MEETING_TZ=Asia/Shanghai
# AI 提炼等模型的上限（毫秒），超时就只保存纪要原文
MEETING_AI_TIMEOUT_MS=60000
